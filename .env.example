# ============================================================
# 環境變數範例 - 複製為 .env 並填入實際值
# ============================================================

# JWT 密鑰（必填，至少 32 字元的隨機字串）
JWT_SECRET=請替換為至少32字元的隨機安全字串
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# 資料庫
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vomatt
DB_USERNAME=vomatt
DB_PASSWORD=請替換為資料庫密碼

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# CORS（逗號分隔，不可使用 *）
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Email（可選）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
