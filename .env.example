# ============================================================
# 環境變數範例 - 複製為 .env 並填入實際值
# ============================================================

# DB（PostgreSQL，schema: vomatt）
DB_URL=jdbc:postgresql://localhost:5432/postgres
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT（JWT_SECRET 至少 32 字元）
JWT_SECRET=
JWT_EXPIRATION_SECONDS=3600
JWT_REFRESH_EXPIRATION_DAYS=30

# OAuth
GOOGLE_CLIENT_ID=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
APPLE_CLIENT_ID=

# Mail
EMAIL_ENABLED=false
EMAIL_FROM=noreply@vomatt.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# CORS（逗號分隔，不可使用 *）
CORS_ALLOWED_ORIGINS=http://localhost:3000

# 其他
PROFILES_ACTIVE=dev
LOG_LEVEL=INFO

# Swagger UI / OpenAPI docs（預設關閉；本機或 dev 設為 true 才會開放）
SWAGGER_ENABLED=true
