# ============================================================
# Example environment variables - copy to .env and fill in real values
# ============================================================

# DB (PostgreSQL, schema: vomatt)
DB_URL=jdbc:postgresql://localhost:5432/postgres
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (JWT_SECRET must be at least 32 characters)
JWT_SECRET=
JWT_EXPIRATION_SECONDS=3600
JWT_REFRESH_EXPIRATION_DAYS=30

# OAuth
GOOGLE_CLIENT_ID=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
APPLE_CLIENT_ID=

# Mail
EMAIL_ENABLED=false
EMAIL_FROM=noreply@vomatt.com
EMAIL_SITE_URL=https://vomatt.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# CORS (comma-separated, * not allowed)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Other
PROFILES_ACTIVE=dev
LOG_LEVEL=INFO

# Swagger UI / OpenAPI docs (disabled by default; set to true locally or in dev to enable)
SWAGGER_ENABLED=true
