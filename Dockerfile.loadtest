# One-shot load test runner for Railway: seeds load-test accounts (LoadTestAccountSeeder) into the environment's
# DB / Redis, then runs k6/vomatt.js against the API, results in the deploy logs. Exits 0 either way, so the default
# ON_FAILURE restart policy never reruns it; redeploy to run again.
# Local check: docker build -f Dockerfile.loadtest -t vomatt-loadtest .

# ---- build ----
FROM eclipse-temurin:25-jdk@sha256:2d5d5e9b533342a565907c84f47a2ec298c40cde7b13a3ca85d4950fa456a641 AS build
WORKDIR /src
COPY mvnw pom.xml ./
COPY .mvn .mvn
RUN ./mvnw -q -B dependency:go-offline
COPY src src
RUN ./mvnw -q -B package -DskipTests && cp target/vomatt-api-*.jar /app.jar

# ---- runtime ----
FROM eclipse-temurin:25-jre@sha256:dbb43d81099eec91e0800226ed2296d03146ee7857165b95112372ad0d67e87f
WORKDIR /app
COPY --from=grafana/k6:1.3.0 /usr/bin/k6 /usr/bin/k6
COPY --from=build /app.jar app.jar
COPY k6 k6
ENV TOKENS=/tmp/loadtest-tokens.csv
CMD ["sh", "-c", "java -Dspring.profiles.active=loadtest -Dloadtest.out=$TOKENS -Dloadtest.users=${LOADTEST_USERS:-100} -jar app.jar && k6 run k6/vomatt.js; echo '[LOADTEST] finished'; exit 0"]
