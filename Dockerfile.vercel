# Vercel Container Images (Beta): when Vercel detects this file it builds the image, pushes it to VCR, and runs it on Fluid compute
# Local check: docker build -f Dockerfile.vercel -t vomatt-api .

# ---- build ----
FROM eclipse-temurin:25-jdk AS build
WORKDIR /src
COPY mvnw pom.xml ./
COPY .mvn .mvn
RUN ./mvnw -q -B dependency:go-offline
COPY src src
RUN ./mvnw -q -B package -DskipTests \
 && java -Djarmode=tools -jar target/vomatt-api-*.jar extract --destination /app

# ---- runtime ----
FROM eclipse-temurin:25-jre
WORKDIR /app
COPY --from=build /app ./
# Vercel cold starts get little CPU: C1-only JIT + AOT cache (JEP 514) shorten startup
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75 -XX:+UseSerialGC -XX:TieredStopAtLevel=1"
# AOT cache training: exits once the context refreshes; startup does not connect to DB / Redis, so placeholder env vars are enough
RUN DB_URL=jdbc:postgresql://localhost/x DB_PASSWORD=x JWT_SECRET=aot-training-placeholder-secret-0123456789 \
    java -XX:AOTCacheOutput=app.aot -Dspring.context.exit=onRefresh -jar vomatt-api-0.0.1-SNAPSHOT.jar
# Vercel routes traffic to port 80 by default; override with the project env var PORT
CMD ["sh", "-c", "exec java -XX:AOTCache=app.aot -Dserver.port=${PORT:-80} -jar vomatt-api-0.0.1-SNAPSHOT.jar"]
