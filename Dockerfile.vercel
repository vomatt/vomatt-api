# Vercel Container Images（Beta）：Vercel 偵測到此檔會自動 build、推到 VCR 並以 Fluid compute 執行
# 本地驗證：docker build -f Dockerfile.vercel -t vomatt-api .

# ---- build ----
FROM eclipse-temurin:25-jdk AS build
WORKDIR /src
COPY mvnw pom.xml ./
COPY .mvn .mvn
RUN ./mvnw -q -B dependency:go-offline
COPY src src
RUN ./mvnw -q -B package -DskipTests \
 && java -Djarmode=tools -jar target/vomatt-api-*.jar extract --destination /app

# ---- runtime ----
FROM eclipse-temurin:25-jre
WORKDIR /app
COPY --from=build /app ./
# Vercel 預設把流量送到 port 80，可用專案環境變數 PORT 覆寫；容器會被縮到零，JVM 調整以降低冷啟動
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75 -XX:+UseSerialGC -Xshare:auto"
CMD ["sh", "-c", "exec java -Dserver.port=${PORT:-80} -jar vomatt-api-0.0.1-SNAPSHOT.jar"]
